DATABASE_URL=sqlite:///./data/question_generator.db
# Railway API Volume: sqlite:////data/db/question_generator.db
# Railway API Volume: /data/exports
EXPORT_ROOT=./output/exports

# Test-phase access gate. Never commit real access codes or secrets.
AUTH_ALLOWED_EMAIL=utils@bodhaai.tech
AUTH_ACCESS_CODES=12345,67890
AUTH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AUTH_SESSION_TTL_HOURS=168
# Set true for the HTTPS Railway deployment; leave false for local HTTP development.
AUTH_COOKIE_SECURE=false

# Used by the Next.js frontend rewrite when set in frontend/.env.local.
BACKEND_URL=http://127.0.0.1:8000

OPENROUTER_API_KEY=
GENERATION_MODEL=
VALIDATION_MODEL=
# After the primary pipeline exhausts MAX_GENERATION_ATTEMPTS, failed slots
# receive another full retry phase using either configured fallback below.
GENERATION_FALLBACK_MODEL=
VALIDATION_FALLBACK_MODEL=
CLASSIFICATION_MODEL=
CLASSIFICATION_FALLBACK_MODEL=
# Set true only when CLASSIFICATION_MODEL accepts page images through OpenRouter.
CLASSIFICATION_USE_VISION=false
EMBEDDING_MODEL=

MAX_CONCURRENT_GENERATIONS=3
MAX_GENERATION_ATTEMPTS=3
MAX_SEED_SIMILARITY=0.90
